{
  "name": "adrift-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed:bots": "tsx src/scripts/seed-bots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "node-cron": "^3.0.3",
    "pg": "^8.14.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.13",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
