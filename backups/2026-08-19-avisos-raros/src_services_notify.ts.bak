/**
 * Aviso ao usuário, por todos os canais que ele tiver.
 *
 * ── Por que isto existe ─────────────────────────────────────────────────────
 *
 * Um barco chegou de manhã e se perdeu à tarde sem que ninguém fosse avisado.
 * A causa não foi um alerta faltando: foi o canal inteiro. Na web, o
 * `registerForPush` do cliente sai na primeira linha, `users.fcm_token` fica
 * NULL, e o envio pelo Expo desiste calado. O único aviso que existia vinha de
 * um vigia DENTRO do app, que só roda com a aba aberta — ou seja, só alcançava
 * quem já estava olhando.
 *
 * A lição que este arquivo grava: **um canal só não é canal**. Quem manda aviso
 * não deve saber por onde ele sai. Diz o que aconteceu; o fanout resolve.
 *
 * ── Os canais, em ordem de alcance ──────────────────────────────────────────
 *
 *   Web Push   navegador, mesmo com a aba e o navegador fechados. É o que
 *              faltava. Não depende de conta em fornecedor nenhum: as chaves
 *              VAPID se geram localmente.
 *   Expo Push  aplicativo Android/iOS. Já existia.
 *   E-mail     o mais lento e o mais confiável. Reservado para o aviso que dói
 *              perder. Ligado junto com RESEND_API_KEY.
 *
 * Todos falham em silêncio: aviso nunca pode derrubar o fluxo que o chamou.
 */
import webpush from 'web-push';
import { pool } from '../db/pool.js';
import { config } from '../config/index.js';
import { enviarEmail, emailDeAviso } from './mail.js';

let vapidPronto = false;
export function webPushLigado(): boolean {
  return !!(config.push.vapidPublic && config.push.vapidPrivate);
}
function prepararVapid(): boolean {
  if (!webPushLigado()) return false;
  if (!vapidPronto) {
    webpush.setVapidDetails(
      config.push.vapidSubject,
      config.push.vapidPublic,
      config.push.vapidPrivate,
    );
    vapidPronto = true;
  }
  return true;
}

export interface Aviso {
  titulo: string;
  corpo: string;
  /** Para onde levar quem tocar no aviso. */
  url?: string;
  /** Substitui um aviso anterior do mesmo assunto em vez de empilhar. */
  tag?: string;
  /** Só para o que dói perder — e só se houver RESEND_API_KEY. */
  porEmail?: boolean;
}

/** Web Push para TODOS os navegadores registrados da pessoa. */
async function porWebPush(userId: string, aviso: Aviso): Promise<number> {
  if (!prepararVapid()) return 0;

  const { rows } = await pool.query(
    `SELECT id, endpoint, p256dh, auth FROM push_subscriptions WHERE user_id = $1`,
    [userId],
  );
  if (!rows.length) return 0;

  const carga = JSON.stringify({
    title: aviso.titulo,
    body: aviso.corpo,
    url: aviso.url ?? '/',
    tag: aviso.tag ?? 'adrift',
  });

  let entregues = 0;
  await Promise.all(rows.map(async (s) => {
    try {
      await webpush.sendNotification(
        { endpoint: s.endpoint, keys: { p256dh: s.p256dh, auth: s.auth } },
        carga,
        { TTL: 6 * 60 * 60 },   // 6h: aviso de barco não serve no dia seguinte
      );
      entregues++;
      await pool.query(
        `UPDATE push_subscriptions SET last_ok_at = NOW() WHERE id = $1`, [s.id],
      );
    } catch (err: any) {
      // 404/410 = o navegador desinstalou a assinatura. Insistir nela é lixo
      // acumulando; apagar é o certo.
      const code = err?.statusCode;
      if (code === 404 || code === 410) {
        await pool.query(`DELETE FROM push_subscriptions WHERE id = $1`, [s.id]);
        console.log(`[aviso] assinatura morta removida (user ${userId})`);
      } else {
        console.warn(`[aviso] web push falhou (user ${userId}): ${code ?? err?.message}`);
      }
    }
  }));
  return entregues;
}

/** Expo Push — o aplicativo. Era o `sendPushToUser` de antes. */
async function porExpo(userId: string, aviso: Aviso): Promise<number> {
  try {
    const { rows } = await pool.query(
      `SELECT fcm_token FROM users WHERE id = $1`, [userId],
    );
    const token: string | null = rows[0]?.fcm_token ?? null;
    if (!token || !token.startsWith('ExponentPushToken')) return 0;

    const res = await fetch('https://exp.host/--/api/v2/push/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        to: token, title: aviso.titulo, body: aviso.corpo,
        sound: 'default', priority: 'high',
      }),
    });
    const data = (await res.json()) as any;
    const status = data?.data?.status ?? data?.errors?.[0]?.code ?? 'unknown';
    if (status !== 'ok') {
      if (data?.data?.details?.error === 'DeviceNotRegistered') {
        await pool.query(`UPDATE users SET fcm_token = NULL WHERE id = $1`, [userId]);
      }
      return 0;
    }
    return 1;
  } catch (err) {
    console.error('[aviso] expo falhou:', err);
    return 0;
  }
}

async function porEmailSeCabivel(userId: string, aviso: Aviso): Promise<number> {
  if (!aviso.porEmail) return 0;
  try {
    const { rows } = await pool.query(
      `SELECT email FROM users WHERE id = $1 AND oauth_provider IS DISTINCT FROM 'bot'`,
      [userId],
    );
    if (!rows.length) return 0;
    // A moldura (logotipo, rodapé, contato) mora em mail.ts. Aqui só dizemos o
    // que aconteceu — antes daqui este aviso saía como um parágrafo solto, sem
    // marca nem jeito de responder.
    const { html, texto } = emailDeAviso(aviso.titulo, aviso.corpo, aviso.url);
    const ok = await enviarEmail(rows[0].email, aviso.titulo, html, texto);
    return ok ? 1 : 0;
  } catch (err) {
    console.error('[aviso] e-mail falhou:', err);
    return 0;
  }
}

/**
 * Manda por todos os canais ao mesmo tempo.
 *
 * De propósito NÃO para no primeiro que der certo: a pessoa pode estar longe do
 * computador e perto do celular, e adivinhar qual é qual foi o que fez o barco
 * se perder. Aviso repetido incomoda; aviso não entregue custa um barco.
 */
export async function avisar(userId: string, aviso: Aviso): Promise<number> {
  const [web, expo, email] = await Promise.all([
    porWebPush(userId, aviso),
    porExpo(userId, aviso),
    porEmailSeCabivel(userId, aviso),
  ]);
  const total = web + expo + email;
  console.log(
    `[aviso] user ${userId} "${aviso.tag ?? '-'}": ` +
    `web=${web} expo=${expo} email=${email}` + (total === 0 ? '  ← NINGUÉM FOI AVISADO' : ''),
  );
  return total;
}

// ── As frases ────────────────────────────────────────────────────────────────
// Ficam juntas para dar para ler a escada inteira de uma vez: cada degrau é mais
// urgente que o anterior, e é isso que precisa soar certo.

export function avisoChegou(): Aviso {
  return {
    titulo: '⛵ Um barco atracou no seu porto',
    corpo: 'Ele traz mensagens de estranhos pelo mundo. Você tem 12 horas para responder antes que ele siga viagem.',
    url: '/receive',
    tag: 'barco-chegou',
  };
}

export function avisoPrazo(horas: number): Aviso {
  return {
    titulo: '⏳ O barco vai zarpar',
    corpo: `Falta${horas === 1 ? '' : 'm'} ${horas} hora${horas === 1 ? '' : 's'} para o barco seguir viagem sem a sua mensagem. Ainda dá tempo.`,
    url: '/receive',
    tag: 'barco-prazo',
    // Este é o que dói perder — é o último aviso antes de o barco ir embora.
    porEmail: true,
  };
}

export function avisoPerdeu(): Aviso {
  return {
    titulo: '🌊 O barco seguiu viagem',
    corpo: 'O prazo acabou e ele partiu para outro porto. Outro vai chegar — o mar não para.',
    url: '/map',
    tag: 'barco-perdido',
  };
}
